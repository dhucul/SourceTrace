<UserControl x:Class="SourceTrace.UI.TraceControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vs="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             Background="{DynamicResource {x:Static vs:VsBrushes.ToolWindowBackgroundKey}}"
             Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
             FontFamily="Segoe UI" FontSize="12" MinWidth="360">
    <UserControl.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Static vs:VsResourceKeys.ButtonStyleKey}}">
            <Setter Property="Padding" Value="8,3"/><Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="MinHeight" Value="26"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource {x:Static vs:VsBrushes.ToolWindowBackgroundKey}}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
            <Setter Property="BorderBrush" Value="#80777777"/><Setter Property="Padding" Value="7,4"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource {x:Static vs:VsBrushes.ToolWindowBackgroundKey}}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
            <Setter Property="Padding" Value="8,3"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="#40777777"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="6,3"/><Setter Property="BorderThickness" Value="0"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="35"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <StackPanel Orientation="Horizontal">
            <Button x:Name="IntoButton" Content="Trace _Into" Click="TraceInto" ToolTip="Step into a function, or launch debugging at the first statement."/>
            <Button x:Name="OverButton" Content="Trace _Over" Click="TraceOver" ToolTip="Execute the current statement without entering called functions."/>
            <Button x:Name="OutButton" Content="Trace O_ut" Click="TraceOut" ToolTip="Run to the caller of the current function."/>
            <Button x:Name="ContinueButton" Content="▶  _Continue Trace" Click="ContinueTrace" FontWeight="SemiBold" ToolTip="Repeatedly trace into source statements until completion or a pause condition."/>
            <Button x:Name="PauseButton" Content="Ⅱ  _Pause" Click="PauseTrace" ToolTip="Stop automatic stepping and request a debugger break."/>
            <Button x:Name="ClearButton" Content="Clear" Click="ClearTrace" ToolTip="Clear the recorded history."/>
            <Button x:Name="ExportButton" Content="Export…" Click="ExportTrace" ToolTip="Save all retained records, including rows hidden by the filter, as JSON or CSV."/>
            <Button Content="Settings" Click="OpenSettings" ToolTip="Change the step delay, record limit, and breakpoint behavior."/>
            <TextBlock Text="v0.6.1" VerticalAlignment="Center" Margin="8,0" Opacity="0.7"/>
            <TextBlock x:Name="CountLabel" Text="0 stops" VerticalAlignment="Center" Margin="0,0,12,0" Opacity="0.7"/>
            <TextBlock Text="Filter" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="FilterBox" Width="140" TextChanged="FilterChanged" AutomationProperties.Name="Filter source trace" ToolTip="Search by function, file, source text, or stop reason."/>
            <CheckBox x:Name="FollowLatest" Content="Follow latest" IsChecked="True" VerticalAlignment="Center" Margin="12,0,4,0"
                      Checked="FollowLatestChanged" Unchecked="FollowLatestChanged" ToolTip="Follow new trace rows and highlight their source in the editor. Select an older row to stop following."/>
        </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="3" Margin="0,4,0,0">
            <DataGrid x:Name="TraceGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                      HeadersVisibility="Column" GridLinesVisibility="None" RowHeaderWidth="0" BorderBrush="#40777777"
                      Background="{DynamicResource {x:Static vs:VsBrushes.ToolWindowBackgroundKey}}"
                      Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                      RowBackground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowBackgroundKey}}"
                      EnableRowVirtualization="True" EnableColumnVirtualization="True" CanUserAddRows="False"
                      CanUserDeleteRows="False" CanUserSortColumns="False" MouseDoubleClick="OpenSelectedSource"
                      SelectionChanged="SelectionChanged" KeyDown="GridKeyDown" AutomationProperties.Name="Source trace history">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Sequence}" Width="65"/>
                    <DataGridTextColumn Header="Thread" Binding="{Binding Location.ThreadId}" Width="70"/>
                    <DataGridTextColumn Header="Frame" Binding="{Binding Location.FrameIndex}" Width="55"/>
                    <DataGridTextColumn Header="Function" Binding="{Binding Location.Function}" Width="220"/>
                    <DataGridTextColumn Header="Line" Binding="{Binding Location.Line}" Width="60"/>
                    <DataGridTextColumn Header="Statement" Binding="{Binding Location.Source}" Width="350"/>
                    <DataGridTextColumn Header="Operation" Binding="{Binding Operation}" Width="120"/>
                    <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="110"/>
                    <DataGridTextColumn Header="File" Binding="{Binding Location.File}" Width="300"/>
                </DataGrid.Columns>
            </DataGrid>
            <Border x:Name="EmptyState" IsHitTestVisible="False" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                <StackPanel MaxWidth="480">
                    <TextBlock Text="Follow the path through your code" FontSize="17" FontWeight="SemiBold" TextAlignment="Center"/>
                    <TextBlock Text="Open a project in Debug configuration. Use Trace Into to begin, or stop at a breakpoint and choose Continue Trace." TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" Opacity="0.7"/>
                </StackPanel>
            </Border>
        </Grid>
        <Expander Grid.Row="4" Margin="0,2,0,0" Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}">
            <Expander.Header>
                <TextBlock x:Name="StatusLabel" TextTrimming="CharacterEllipsis" ToolTip="Expand for the selected statement and activity details."/>
            </Expander.Header>
        <StackPanel>
            <TextBlock x:Name="LocationLabel" Text="Double-click a row to open its source location." TextTrimming="CharacterEllipsis" Opacity="0.75"/>
            <TextBox x:Name="StatementBox" IsReadOnly="True" BorderThickness="0" Padding="0,4" FontFamily="Consolas" TextWrapping="Wrap" MaxHeight="65" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Selected source statement"/>
            <TextBlock x:Name="ActivityLabel" TextWrapping="Wrap" Opacity="0.8" Margin="0,4,0,0"/>
        </StackPanel>
        </Expander>
        <StackPanel Grid.Row="5">
            <TextBlock x:Name="RecordingNotice" TextWrapping="Wrap" FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</UserControl>
